# Variáveis de ambiente do site (copiar para .env.local no dev; setar no provedor no deploy)

# URLs do dashboard/API bbai (client-side, entram no bundle)
NEXT_PUBLIC_BBAI_API_URL=https://ai.bestbarbers.app
NEXT_PUBLIC_BBAI_DASHBOARD_URL=https://bbai.bestbarbers.app

# Chave da API Ploomes — SERVER-SIDE APENAS (sem prefixo NEXT_PUBLIC; nunca vai pro bundle).
# Usada pelo route handler src/app/api/ploomes/route.ts, que faz o proxy para api2.ploomes.com.
PLOOMES_API_KEY=coloque-a-chave-do-ploomes-aqui
